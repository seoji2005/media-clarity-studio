{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.media-clarity-studio.invalid/translated-transcript-v1.schema.json",
  "title": "TranslatedTranscript/v1",
  "description": "ARCHITECTURE.md §7.11 번역 산출물의 기계 정본 (TASK-029 §4.4). 원문 Transcript를 참조·보존하며 대체하지 않는다. TranslationCapabilityReport는 이 파일의 $defs에만 정의하고 다른 schema나 Python 상수에 복제하지 않는다. $id는 안정 식별자이며 네트워크 주소가 아니다(.invalid, RFC 2606).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "translated_transcript_id",
    "timebase_ref",
    "source_transcript",
    "target_language",
    "streams",
    "coverage_status",
    "uncovered_source_fragments",
    "feature_status",
    "capability_report",
    "provenance"
  ],
  "properties": {
    "schema_version": { "$ref": "common-v1.schema.json#/$defs/schema_version" },
    "translated_transcript_id": { "$ref": "common-v1.schema.json#/$defs/identifier" },
    "timebase_ref": {
      "description": "원문 Transcript와 동일한 시간축 (E_SOURCE_REF).",
      "$ref": "common-v1.schema.json#/$defs/identifier"
    },
    "source_transcript": {
      "description": "입력이 된 원문 Transcript 참조 — 대체가 아니다.",
      "$ref": "common-v1.schema.json#/$defs/ArtifactRef"
    },
    "target_language": {
      "description": "현재 제품의 성공 산출물은 정확히 ko다. 누락·비-ko는 E_TARGET_LANGUAGE 계약 실패다. 원문 언어의 정답은 source Transcript의 language_spans이며 이 문서에 literal authority 경로를 두지 않는다.",
      "$ref": "adapter-capability-report-v1.schema.json#/$defs/language_tag"
    },
    "streams": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Stream" }
    },
    "coverage_status": {
      "description": "complete는 uncovered_source_fragments가 비어 있을 때와 동치, partial은 하나 이상일 때와 동치다 (E_SOURCE_COVERAGE).",
      "enum": ["complete", "partial"]
    },
    "uncovered_source_fragments": {
      "description": "번역되지도 dropped로 기록되지도 않은 원문 범위. complete·partial 모두에서 covered 범위와 합쳐 원문을 정확히 한 번 partition해야 한다.",
      "type": "array",
      "items": { "$ref": "#/$defs/UncoveredFragment" }
    },
    "feature_status": {
      "description": "실행별 기능 상태. 임의 map이 아니라 두 key가 모두 있는 닫힌 객체다.",
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_alignment", "translation_confidence"],
      "properties": {
        "segment_alignment": { "$ref": "adapter-capability-report-v1.schema.json#/$defs/feature_status_value" },
        "translation_confidence": { "$ref": "adapter-capability-report-v1.schema.json#/$defs/feature_status_value" }
      }
    },
    "capability_report": {
      "description": "실행 당시 report의 immutable snapshot.",
      "$ref": "#/$defs/TranslationCapabilityReport"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter_id", "adapter_version", "params_hash"],
      "properties": {
        "adapter_id": { "$ref": "common-v1.schema.json#/$defs/identifier" },
        "adapter_version": { "type": "string", "minLength": 1 },
        "params_hash": { "$ref": "common-v1.schema.json#/$defs/content_hash" },
        "seed": { "type": "integer" }
      }
    }
  },
  "$defs": {
    "TranslationCapabilityReport": {
      "description": "ARCHITECTURE.md §7.11 번역 어댑터 능력 보고의 유일한 정본 정의 (TASK-029 §3·§4.4). 닫힌 field set이며 다른 schema나 Python 상수가 이 enum·필드 집합을 복제하지 않는다.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_id",
        "adapter_version",
        "supported_source_languages",
        "supported_target_languages",
        "supports_segment_alignment",
        "supports_document_context",
        "supports_code_switching_input",
        "translation_confidence_semantics",
        "network_requirement",
        "requires_gpu",
        "determinism_tier",
        "limitations"
      ],
      "properties": {
        "adapter_id": { "$ref": "common-v1.schema.json#/$defs/identifier" },
        "adapter_version": { "type": "string", "minLength": 1 },
        "supported_source_languages": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "adapter-capability-report-v1.schema.json#/$defs/language_tag" }
        },
        "supported_target_languages": {
          "description": "성공 결과를 낼 snapshot에는 exact ko가 있어야 한다 (E_TARGET_LANGUAGE).",
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "adapter-capability-report-v1.schema.json#/$defs/language_tag" }
        },
        "supports_segment_alignment": {
          "description": "model이 semantic alignment를 직접 보고하는 능력이다. orchestrator의 실제 입력 fragment lineage 보존 의무를 끄지 않는다.",
          "type": "boolean"
        },
        "supports_document_context": { "type": "boolean" },
        "supports_code_switching_input": { "type": "boolean" },
        "translation_confidence_semantics": {
          "$ref": "adapter-capability-report-v1.schema.json#/$defs/confidence_semantics"
        },
        "network_requirement": {
          "$ref": "adapter-capability-report-v1.schema.json#/$defs/network_requirement"
        },
        "requires_gpu": { "type": "boolean" },
        "determinism_tier": {
          "$ref": "adapter-capability-report-v1.schema.json#/$defs/determinism_tier"
        },
        "limitations": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "Stream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream_id", "segments"],
      "properties": {
        "stream_id": {
          "description": "원문 Transcript.streams[].stream_id와 같은 값이어야 한다 (E_SOURCE_REF).",
          "$ref": "common-v1.schema.json#/$defs/identifier"
        },
        "segments": {
          "type": "array",
          "items": { "$ref": "#/$defs/Segment" }
        }
      }
    },
    "Segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "source_fragments",
        "target_text",
        "alignment_kind",
        "alignment_evidence_source",
        "is_low_confidence",
        "needs_review",
        "review_reasons"
      ],
      "properties": {
        "segment_id": { "$ref": "common-v1.schema.json#/$defs/identifier" },
        "source_fragments": {
          "description": "source fragment 없이 성공 번역 segment를 만들 수 없다. adapter가 정렬을 보고하지 못해도 orchestrator가 실제로 공급한 입력 범위는 lineage로 남는다.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/SourceFragment" }
        },
        "target_text": {
          "description": "번역 결과. dropped이면 빈 문자열이고 그 외 alignment_kind에서는 비어 있을 수 없다. source_text와 하나의 필드로 합치지 않는다.",
          "type": "string"
        },
        "alignment_kind": {
          "enum": ["one_to_one", "merged", "split", "dropped", "unknown"]
        },
        "alignment_evidence_source": {
          "description": "adapter는 모델이 직접 보고한 semantic alignment, orchestrator는 실제 요청 fragment 계보만 뜻한다.",
          "enum": ["adapter", "orchestrator"]
        },
        "confidence": {
          "description": "translation_confidence_semantics != none일 때만 존재한다. 미지원이면 생략하며 1.0으로 채우지 않는다.",
          "type": "number"
        },
        "is_low_confidence": { "type": "boolean" },
        "needs_review": { "type": "boolean" },
        "review_reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/review_reason" }
        },
        "review_extension_id": { "$ref": "transcript-v1.schema.json#/$defs/extension_id" }
      }
    },
    "SourceFragment": {
      "description": "원문 segment exact text의 Unicode scalar 반개구간과 그 범위의 exact substring.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source_segment_id", "char_start", "char_end", "source_text"],
      "properties": {
        "source_segment_id": { "$ref": "common-v1.schema.json#/$defs/identifier" },
        "char_start": { "type": "integer", "minimum": 0 },
        "char_end": { "type": "integer", "minimum": 0 },
        "source_text": { "type": "string" }
      }
    },
    "UncoveredFragment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_segment_id",
        "char_start",
        "char_end",
        "source_text",
        "needs_review",
        "review_reasons"
      ],
      "properties": {
        "source_segment_id": { "$ref": "common-v1.schema.json#/$defs/identifier" },
        "char_start": { "type": "integer", "minimum": 0 },
        "char_end": { "type": "integer", "minimum": 0 },
        "source_text": { "type": "string" },
        "needs_review": {
          "description": "uncovered fragment는 항상 true다 (E_REVIEW_STATE).",
          "type": "boolean"
        },
        "review_reasons": {
          "description": "비어 있을 수 없다 — 이것이 uncovered의 안정 reason이다.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/review_reason" }
        },
        "review_extension_id": { "$ref": "transcript-v1.schema.json#/$defs/extension_id" }
      }
    },
    "review_reason": {
      "enum": [
        "low_confidence",
        "untranslated_span",
        "alignment_uncertain",
        "source_ambiguous",
        "other"
      ]
    }
  }
}

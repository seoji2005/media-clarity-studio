{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://media-clarity-studio.local/schemas/calibration-environment-evidence-v1.schema.json",
  "title": "TASK-031 target-Windows environment evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "environment_id",
    "captured_at",
    "dependency_input_sha256",
    "lock_sha256",
    "probe"
  ],
  "properties": {
    "schema_version": {"$ref": "common-v1.schema.json#/$defs/schema_version"},
    "kind": {"const": "task031_environment_evidence"},
    "environment_id": {"enum": ["download", "faster-whisper", "qwen-asr", "translation"]},
    "captured_at": {"$ref": "common-v1.schema.json#/$defs/timestamp"},
    "dependency_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "lock_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "probe": {"$ref": "#/$defs/probe"}
  },
  "$defs": {
    "name_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "os_version", "os_build", "architecture"],
      "properties": {
        "os": {"const": "windows"},
        "os_version": {"const": "11"},
        "os_build": {"type": "string", "minLength": 1},
        "architecture": {"const": "x86_64"}
      }
    },
    "python": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "executable_path", "executable_sha256"],
      "properties": {
        "version": {"const": "3.12"},
        "executable_path": {"type": "string", "minLength": 1},
        "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "resolver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "raw_output", "executable_path", "executable_sha256"],
      "properties": {
        "name": {"const": "uv"},
        "version": {"type": "string", "minLength": 1},
        "raw_output": {"type": "string", "pattern": "^uv [^\\s]+"},
        "executable_path": {"type": "string", "minLength": 1},
        "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid",
        "name",
        "driver_version",
        "reported_vram_mib",
        "driver_supported_cuda_version",
        "nvidia_smi_path",
        "nvidia_smi_sha256"
      ],
      "properties": {
        "uuid": {"type": "string", "pattern": "^GPU-[A-Za-z0-9-]+$"},
        "name": {"const": "NVIDIA GeForce RTX 4070 SUPER"},
        "driver_version": {"type": "string", "minLength": 1},
        "reported_vram_mib": {"type": "integer", "minimum": 12000, "maximum": 12288},
        "driver_supported_cuda_version": {"type": "string", "minLength": 1},
        "nvidia_smi_path": {"type": "string", "minLength": 1},
        "nvidia_smi_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cuda_stack_status",
        "torch_version",
        "cuda_version",
        "cudnn_version",
        "cuda_available"
      ],
      "properties": {
        "cuda_stack_status": {"enum": ["not_applicable", "windows_locked"]},
        "torch_version": {"type": "string"},
        "cuda_version": {"type": "string"},
        "cudnn_version": {"type": "string"},
        "cuda_available": {"type": "boolean"}
      }
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "probe_implementation_sha256",
        "host",
        "python",
        "resolver",
        "direct_packages",
        "gpu",
        "runtime"
      ],
      "properties": {
        "probe_implementation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "host": {"$ref": "#/$defs/host"},
        "python": {"$ref": "#/$defs/python"},
        "resolver": {"$ref": "#/$defs/resolver"},
        "direct_packages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/name_version"}
        },
        "gpu": {"$ref": "#/$defs/gpu"},
        "runtime": {"$ref": "#/$defs/runtime"}
      }
    }
  }
}
